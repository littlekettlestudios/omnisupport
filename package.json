{
  "name": "omni-support",
  "productName": "Omni Support",
  "version": "0.0.1",
  "description": "A desktop companion that looks at what you point it to and finds answers",
  "license": "MIT",
  "author": "Little Kettle Studios",
  "repository": {
    "type": "git",
    "url": "https://github.com/littlekettlestudios/omnisupport.git"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac --dir"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "^4.0.0",
    "three": "^0.180.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "build": {
    "appId": "com.littlekettlestudios.omnisupport",
    "productName": "Omni Support",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "assets/**",
      "resources/**",
      "package.json",
      "!assets/**/*.blend*",
      "!assets/sprites/*/source/**"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSMultipleInstancesProhibited": true
      }
    }
  }
}
